load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

package(default_visibility = ["//visibility:public"])

exports_files([".swcrc"])

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
)

ts_config(
    name = "tsconfig_test",
    src = "tsconfig.test.json",
    visibility = [":__subpackages__"],
)

ts_project(
    name = "utils",
    srcs = glob(["utils/**/*.ts"]),
    declaration = True,
)

ts_project(
    name = "tetris",
    srcs = glob([
        "tetris-effect.ts",
        "tetris/**/*.ts",
    ]),
    declaration = True,
    deps = [
        ":utils",
    ],
)

esbuild(
    name = "tetris-bundle",
    entry_point = "tetris-effect.ts",
    metafile = False,
    minify = True,
    sourcemap = False,
    target = "esnext",
    tsconfig = ":tsconfig",
    deps = [
        ":tetris",
    ],
)

ts_project(
    name = "snowflake",
    srcs = glob([
        "snowflake-effect.ts",
        "snowflake/**/*.ts",
    ]),
    declaration = True,
    deps = [
        ":utils",
    ],
)

esbuild(
    name = "snowflake-bundle",
    entry_point = "snowflake-effect.ts",
    metafile = False,
    minify = True,
    sourcemap = False,
    target = "esnext",
    tsconfig = ":tsconfig",
    deps = [
        ":snowflake",
    ],
)

ts_project(
    name = "tennis",
    srcs = glob([
        "tennis-effect.ts",
        "tennis/**/*.ts",
    ]),
    declaration = True,
    deps = [
        ":utils",
    ],
)

esbuild(
    name = "tennis-bundle",
    bundle = True,
    entry_point = "tennis-effect.ts",
    metafile = False,
    minify = True,
    sourcemap = False,
    target = "esnext",
    tsconfig = ":tsconfig",
    deps = [
        ":tennis",
    ],
)

ts_project(
    name = "month",
    srcs = glob([
        "month-effect.ts",
        "month/**/*.ts",
    ]),
    declaration = True,
    deps = [
        ":utils",
    ],
)

ts_project(
    name = "chat",
    srcs = glob(
        [
            "chat-effect.ts",
            "chat/**/*.ts",
        ],
        exclude = ["chat/**/*.test.ts"],
    ),
    declaration = True,
    deps = [
        ":utils",
    ],
)

ts_project(
    name = "chat_test",
    srcs = ["chat/protocol.test.ts"],
    declaration = True,
    tsconfig = ":tsconfig_test",
    deps = [
        ":chat",
        "//:node_modules/@types/node",
    ],
)

esbuild(
    name = "chat-bundle",
    entry_point = "chat-effect.ts",
    metafile = False,
    minify = True,
    sourcemap = False,
    target = "esnext",
    tsconfig = ":tsconfig",
    deps = [
        ":chat",
    ],
)

esbuild(
    name = "chat-protocol-test-bin",
    bundle = True,
    entry_point = "chat/protocol.test.ts",
    metafile = False,
    minify = False,
    platform = "node",
    sourcemap = False,
    target = "esnext",
    tsconfig = ":tsconfig",
    deps = [
        ":chat_test",
    ],
)

js_test(
    name = "chat-protocol-test",
    data = [":chat-protocol-test-bin"],
    entry_point = ":chat-protocol-test-bin",
)

ts_project(
    name = "chat_attachments_proto_test",
    srcs = ["chat/attachments-proto.test.ts"],
    declaration = True,
    tsconfig = ":tsconfig_test",
    deps = [
        ":chat",
        "//:node_modules/@types/node",
    ],
)

esbuild(
    name = "chat-attachments-proto-test-bin",
    bundle = True,
    entry_point = "chat/attachments-proto.test.ts",
    metafile = False,
    minify = False,
    platform = "node",
    sourcemap = False,
    target = "esnext",
    tsconfig = ":tsconfig",
    deps = [
        ":chat_attachments_proto_test",
    ],
)

js_test(
    name = "chat-attachments-proto-test",
    data = [":chat-attachments-proto-test-bin"],
    entry_point = ":chat-attachments-proto-test-bin",
)

esbuild(
    name = "month-bundle",
    entry_point = "month-effect.ts",
    metafile = False,
    minify = True,
    sourcemap = False,
    target = "esnext",
    tsconfig = ":tsconfig",
    deps = [
        ":month",
    ],
)

filegroup(
    name = "metrika",
    srcs = ["mc.js"],
)
