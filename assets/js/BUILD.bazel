load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("//tools/closure:defs.bzl", "advanced_bundle")

package(default_visibility = ["//visibility:public"])

exports_files([".swcrc"])

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
)

ts_config(
    name = "tsconfig_test",
    src = "tsconfig.test.json",
    visibility = [":__subpackages__"],
)

# ── Generate gen/styles.ts from the CSS class-name mapping ───────────────────

genrule(
    name = "styles_ts",
    srcs = ["//assets/css:css_build"],
    outs = ["gen/styles.ts"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath //assets/js/tools:gen_styles_ts_bin) $$PWD/$(location //assets/css:css_build)/style.module.json $$PWD/$@",
    tags = ["local"],
    tools = ["//assets/js/tools:gen_styles_ts_bin"],
)

# ── Generate gen/chat.ts from the proto descriptor ────────────────────────────

genrule(
    name = "chat_ts",
    srcs = ["//server:chat_descriptor_json"],
    outs = ["gen/chat.ts"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath //assets/js/tools:gen_proto_bin) $$PWD/$(location //server:chat_descriptor_json) $$PWD/$@ ../utils/proto-utils",
    tags = ["local"],
    tools = ["//assets/js/tools:gen_proto_bin"],
)

ts_project(
    name = "gen",
    srcs = [
        ":chat_ts",
        ":styles_ts",
    ],
    declaration = True,
    deps = [":utils"],
)

ts_project(
    name = "utils",
    srcs = glob(
        ["utils/**/*.ts"],
        exclude = ["utils/**/*.test.ts"],
    ),
    declaration = True,
)

ts_project(
    name = "tetris",
    srcs = glob([
        "tetris-effect.ts",
        "tetris/**/*.ts",
    ]),
    declaration = True,
    deps = [
        ":gen",
    ],
)

advanced_bundle(
    name = "tetris-bundle",
    entry_point = "tetris-effect.ts",
    deps = [
        ":tetris",
    ],
)

ts_project(
    name = "snowflake",
    srcs = glob([
        "snowflake-effect.ts",
        "snowflake/**/*.ts",
    ]),
    declaration = True,
    deps = [
        ":utils",
    ],
)

advanced_bundle(
    name = "snowflake-bundle",
    entry_point = "snowflake-effect.ts",
    deps = [
        ":snowflake",
    ],
)

ts_project(
    name = "tennis",
    srcs = glob([
        "tennis-effect.ts",
        "tennis/**/*.ts",
    ]),
    declaration = True,
    deps = [
        ":gen",
    ],
)

advanced_bundle(
    name = "tennis-bundle",
    entry_point = "tennis-effect.ts",
    deps = [
        ":tennis",
    ],
)

ts_project(
    name = "month",
    srcs = glob(
        [
            "month-effect.ts",
            "month/**/*.ts",
        ],
        exclude = ["month/**/*.test.ts"],
    ),
    declaration = True,
    deps = [
        ":gen",
    ],
)

ts_project(
    name = "chat",
    srcs = glob(
        [
            "chat-effect.ts",
            "chat/**/*.ts",
        ],
        exclude = ["chat/**/*.test.ts"],
    ),
    declaration = True,
    deps = [
        ":gen",
    ],
)

ts_project(
    name = "chat_tests",
    srcs = glob(["**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig_test",
    deps = [
        ":chat",
        ":gen",
        ":month",
        ":utils",
        "//:node_modules/@types/node",
    ],
)

[
    (
        esbuild(
            name = src.removesuffix(".ts") + "-bin",
            bundle = True,
            entry_point = src,
            metafile = False,
            minify = False,
            platform = "node",
            sourcemap = False,
            target = "esnext",
            tsconfig = ":tsconfig",
            deps = [":chat_tests"],
        ),
        js_test(
            name = src.removesuffix(".ts"),
            data = [src.removesuffix(".ts") + "-bin"],
            entry_point = src.removesuffix(".ts") + "-bin",
            node_options = ["--test"],
        ),
    )
    for src in glob(["**/*.test.ts"])
]

advanced_bundle(
    name = "chat-bundle",
    entry_point = "chat-effect.ts",
    deps = [
        ":chat",
    ],
)

advanced_bundle(
    name = "month-bundle",
    entry_point = "month-effect.ts",
    deps = [
        ":month",
    ],
)

filegroup(
    name = "metrika",
    srcs = ["mc.js"],
)
